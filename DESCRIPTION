Encoding: UTF-8
Language: fi
Depends: R (>= 4.1)
Imports:
    httr,
    jsonlite,
    stats,
    tools
Suggests:
    ggplot2,
    testthat (>= 3.0.0)
Config/testthat/edition: 3
